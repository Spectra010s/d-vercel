{
  "name": "d-vercel",
  "version": "1.2.0",
  "private": true,
  "description": "Seamlessly deploy frontend and full-stack applications to Vercel from GitHub Actions.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Spectra010s",
    "email": "spectra010s@gmail.com",
    "url": "https://spectra010s.biuld.app"
  },
  "homepage": "https://github.com/Spectra010s/d-vercel",
  "main": "dist/index.js",
  "scripts": {
    "package": "rimraf ./dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "git-aic",
    "all": "npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spectra010s/d-vercel.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Vercel",
    "d-vercel",
    "Vercel Deployment"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.2.3",
    "git-aic": "^1.3.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
